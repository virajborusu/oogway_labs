# The Lenny Growth Assistant
PROJECT_NAME=The Lenny Growth Assistant
LOG_LEVEL=INFO

# Docker/PostgreSQL (recommended submission/demo path)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/lenny_assistant

# LLM provider: ollama | anthropic | openai
LLM_PROVIDER=ollama

# Local Ollama. Ollama runs on your Windows host while the backend runs in Docker.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2

# Optional cloud providers
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# RAG
TOP_K_RETRIEVAL=4
SIMILARITY_THRESHOLD=0.25
